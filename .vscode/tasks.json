{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Main",
            "type": "shell",
            "windows": {"command": "cd src ; python main.py"},
            "linux": {"command": "cd src && python main.py"},
            "osx": {"command": "cd src && python main.py"},
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Testbed",
            "type": "shell",
            "windows": {"command": "cd src ; python testbed.py"},
            "linux": {"command": "cd src && python testbed.py"},
            "osx": {"command": "cd src && python testbed.py"},
            "group": {
                "kind": "test",
                "isDefault": false
            }
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "windows": {"command": "cd src ; python ../test/_main.py"},
            "linux": {"command": "cd src && python ../test/_main.py"},
            "osx": {"command": "cd src && python ../test/_main.py"},
            "group": {
                "kind": "test",
                "isDefault": false
            }
        }
    ]
}